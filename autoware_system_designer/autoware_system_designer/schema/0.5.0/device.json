{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Device Entity Schema 0.5.0",
  "description": "Schema for autoware_system_design_format device entities",
  "type": "object",
  "required": [
    "name"
  ],
  "additionalProperties": false,
  "properties": {
    "autoware_system_design_format": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+\\.device$"
    },
    "description": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "ecu",
        "switch",
        "router",
        "sensor",
        "actuator",
        "other"
      ],
      "description": "ecu: hosts compute units; switch, router: forwards between its interfaces; sensor, actuator: peripheral hardware"
    },
    "hardware": {
      "type": "string",
      "description": "Hardware class of the device (e.g. x86_64, jetson_orin)"
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Interface name on the device (e.g. eth0, mgbe1, can0, p1)"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "ethernet",
              "can",
              "lin",
              "flexray",
              "serial",
              "gmsl",
              "usb",
              "other"
            ],
            "description": "Medium of the interface; a connection joins interfaces of one type"
          },
          "bitrate": {
            "description": "Capacity in bit/s: an integer, or a number with suffix k, M or G (e.g. 500k, 10G)",
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]+)?[kMG]?$"
              }
            ]
          }
        }
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "host",
              "container",
              "vm"
            ],
            "description": "host: the device's operating system; container, vm: an isolated environment on it"
          },
          "network": {
            "type": "string",
            "enum": [
              "host",
              "own"
            ],
            "description": "host (default): shares the device's network namespace, loopback included; own: has its own network namespace and address"
          },
          "shared_memory": {
            "type": "boolean",
            "description": "Shares the device's shared memory with the other environments of the device that set it (default false)"
          },
          "provides": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "description": "Capabilities the environment provides to the compute units bound to it (e.g. gpu)"
          }
        }
      }
    },
    "parts": {
      "type": "array",
      "description": "Devices inside this one (SoCs of a board, an on-board switch)",
      "items": {
        "type": "object",
        "required": [
          "name",
          "device"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": {
            "type": "string"
          },
          "device": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+\\.device$"
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": {
            "type": "string"
          },
          "link": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[A-Za-z0-9_-]+)*$",
              "description": "<interface> of this device or <part>.<interface>"
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "Point-to-point connection of two interfaces"
          },
          "bus": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[A-Za-z0-9_-]+)*$",
              "description": "<interface> of this device or <part>.<interface>"
            },
            "minItems": 2,
            "uniqueItems": true,
            "description": "Shared medium joining several interfaces (e.g. a CAN bus)"
          },
          "bitrate": {
            "description": "Capacity in bit/s: an integer, or a number with suffix k, M or G (e.g. 500k, 10G)",
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]+)?[kMG]?$"
              }
            ]
          }
        },
        "oneOf": [
          {
            "required": [
              "link"
            ]
          },
          {
            "required": [
              "bus"
            ]
          }
        ]
      }
    }
  }
}
